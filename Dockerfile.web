# syntax=docker/dockerfile:1.7

FROM node:20.11.1-alpine3.19 AS build
WORKDIR /workspace

COPY package.json package-lock.json nx.json tsconfig.base.json tsconfig.json ./
COPY apps/chatviewer-api/package.json apps/chatviewer-api/package.json
COPY apps/chatviewer-web/package.json apps/chatviewer-web/package.json
RUN npm ci

COPY . .

# Allow overriding the API base URL and Google client id at build time
ARG VITE_API_BASE_URL
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

RUN npx nx build chatviewer-web --configuration production

FROM nginx:1.27.2-alpine
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/apps/chatviewer-web/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
