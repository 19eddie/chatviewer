# Copy to .env.docker and tweak as needed for local development
# DATABASE_URL should point to the compose service name `db`
DATABASE_URL=postgres://chatviewer:chatviewer@db:5432/chatviewer

# Optional override (omit to use the built-in default insecure secret)
# JWT_SECRET=change-me

# Optional: front-end API endpoint override for the SPA build
# VITE_API_BASE_URL=http://chatviewer-api:8000
